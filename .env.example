# Orbit Phase 1 environment.
# Copy to .env and adjust. Never commit a real .env file.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Leave unset to use a local SQLite database (fine for development and tests).
# DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Defaults to DJANGO_SECRET_KEY.
# JWT_SIGNING_KEY=

# Development-only demo account. Ignored unless DJANGO_DEBUG=true.
DEMO_SEED=false
DEMO_EMAIL=demo@orbit.dev
DEMO_PASSWORD=orbit-demo-pass
DEMO_ORGANIZATION=Northwind Studio

# Frontend (Vite). Relative /api is proxied to the Django server.
VITE_API_BASE=/api
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
